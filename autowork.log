import tokenize, io, os

# Batch 1: _shared/ files
# - query -> zapros (discovery.py, planner.py, server.py - parameter names)
# - desc -> opisanie_kratkoe (discovery.py) 
# - block -> blok (discovery.py, planner.py)
# - wait -> ozhidanie (http_client.py, rate_limiter.py)
# - check -> proverochnaya_tsifra (validators.py)

renames_map = {
    'query': 'zapros',
    'desc': 'opisanie_kratkoe', 
    'block': 'blok',
    'wait': 'ozhidanie',
    'check': 'proverochnaya_tsifra',
}

# Built-in function names to NOT rename
builtins = {'min', 'max', 'next', 'type', 'format', 'range', 'len', 'sum', 'any', 'all', 'abs', 'round', 'print', 'sorted', 'enumerate', 'zip', 'map', 'filter', 'isinstance', 'issubclass', 'hasattr', 'getattr', 'setattr', 'delattr', 'callable', 'super', 'property', 'classmethod', 'staticmethod'}

target_files = {
    'src/mcp_russia/_shared/discovery.py': {'query', 'desc', 'block'},
    'src/mcp_russia/_shared/planner.py': {'query', 'block'},
    'src/mcp_russia/_shared/http_client.py': {'wait'},
    'src/mcp_russia/_shared/rate_limiter.py': {'wait'},
    'src/mcp_russia/_shared/validators.py': {'check'},
    'src/mcp_russia/server.py': {'query'},
}

total_count = 0

for filepath, target_names in target_files.items():
    with open(filepath, 'r') as fh:
        source = fh.read()
    
    tokens = list(tokenize.generate_tokens(io.StringIO(source).readline))
    replacements = {}
    prev_tok = None
    
    for i, tok in enumerate(tokens):
        if tok.type == tokenize.NAME and tok.string in target_names and tok.string in renames_map:
            # Skip after dot (attribute access)
            if prev_tok and prev_tok.type == tokenize.OP and prev_tok.string == '.':
                prev_tok = tok
                continue
            replacements[i] = renames_map[tok.string]
        prev_tok = tok
    
    if replacements:
        new_tokens = list(tokens)
        for i, new_name in replacements.items():
            tok = tokens[i]
            new_tok = tokenize.TokenInfo(tok.type, new_name, tok.start, tok.end, tok.line)
            new_tokens[i] = new_tok
        
        new_source = tokenize.untokenize(new_tokens)
        with open(filepath, 'w') as fh:
            fh.write(new_source)
        total_count += len(replacements)
        print(f'{filepath}: {len(replacements)} replacements')
        for i, new_name in replacements.items():
            print(f'  L{tokens[i].start[0]}: {tokens[i].string} → {new_name}')

print(f'\\nTotal: {total_count} replacements')
"

