import tokenize, io, os, ast

# Step 1: Identify files and Pydantic constructor call sites where 'data=' should NOT be renamed
pydantic_data_args = set()  # (filepath, lineno) pairs

for root, dirs, files in os.walk('src/mcp_russia'):
    dirs[:] = [d for d in dirs if d != '__pycache__']
    for f in files:
        if not f.endswith('.py'):
            continue
        filepath = os.path.join(root, f)
        
        with open(filepath, 'r') as fh:
            source = fh.read()
        
        try:
            tree = ast.parse(source)
        except:
            continue
        
        for node in ast.walk(tree):
            if isinstance(node, ast.Call):
                for kw in node.keywords:
                    if kw.arg == 'data':
                        pydantic_data_args.add((filepath, node.lineno))

# Step 2: Also identify function parameters where 'data' means 'date'
date_param_functions = set()  # (filepath, func_name) pairs
for root, dirs, files in os.walk('src/mcp_russia'):
    dirs[:] = [d for d in dirs if d != '__pycache__']
    for f in files:
        if not f.endswith('.py'):
            continue
        filepath = os.path.join(root, f)
        
        with open(filepath, 'r') as fh:
            source = fh.read()
        
        try:
            tree = ast.parse(source)
        except:
            continue
        
        for node in ast.walk(tree):
            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
                for arg in node.args.args:
                    if arg.arg == 'data':
                        # Check if type annotation is str (date) vs dict/Any (data)
                        ann = ''
                        if arg.annotation:
                            if isinstance(arg.annotation, ast.Name):
                                ann = arg.annotation.id
                            elif isinstance(arg.annotation, ast.Subscript):
                                if isinstance(arg.annotation.value, ast.Name):
                                    ann = arg.annotation.value.id
                            elif isinstance(arg.annotation, ast.BinOp):
                                ann = 'Union'
                        
                        # If annotation is str, it means 'date' -> don't rename
                        if ann == 'str':
                            date_param_functions.add((filepath, node.name))
                            # print(f'DATE PARAM: {filepath}:{node.lineno} {node.name}(data: str)')

# Also don't rename 'data' in handle_data method (SAX callback)
date_param_functions.add(('src/mcp_russia/data/cekrf/client.py', 'handle_data'))

print(f'Pydantic data= args: {len(pydantic_data_args)}')
print(f'Date param functions: {len(date_param_functions)}')
for fp, fn in sorted(date_param_functions):
    print(f'  {fp}: {fn}')
print(f'Pydantic args:')
for fp, ln in sorted(pydantic_data_args):
    print(f'  {fp}:{ln}')

# Step 3: Rename 'data' -> 'dannye' in client.py and tools.py files
total_count = 0
total_files = 0

for root, dirs, files in os.walk('src/mcp_russia'):
    dirs[:] = [d for d in dirs if d != '__pycache__']
    for f in files:
        if not f.endswith('.py'):
            continue
        filepath = os.path.join(root, f)
        
        # Skip schemas.py files - all 'data' there means 'date'
        if filepath.endswith('schemas.py'):
            continue
        
        # Skip prompts.py - 'text' and 'type' there are MCP protocol fields
        if filepath.endswith('prompts.py'):
            continue
        
        # Only process client.py and tools.py (and some _shared files)
        basename = os.path.basename(filepath)
        dirname = os.path.basename(os.path.dirname(filepath))
        if basename not in ('client.py', 'tools.py', 'constants.py', 'resources.py') and dirname != '_shared':
            continue
        
        with open(filepath, 'r') as fh:
            source = fh.read()
        
        tokens = list(tokenize.generate_tokens(io.StringIO(source).readline))
        replacements = {}
        prev_tok = None
        
        for i, tok in enumerate(tokens):
            if tok.type == tokenize.NAME and tok.string == 'data':
                # Skip after dot (attribute access)
                if prev_tok and prev_tok.type == tokenize.OP and prev_tok.string == '.':
                    prev_tok = tok
                    continue
                
                lineno = tok.start[0]
                col = tok.start[1]
                
                # Check if this is a Pydantic constructor keyword arg
                if (filepath, lineno) in pydantic_data_args:
                    prev_tok = tok
                    continue
                
                # Check if we're inside a date-param function
                # We need to determine which function we're in
                # Simple heuristic: check if the function with data:date param is on a nearby line
                skip = False
                for fp, fn in date_param_functions:
                    if fp == filepath:
                        # Check if we're inside this function
                        # Find the function definition line
                        pass  # We'll handle this differently
                
                replacements[i] = 'dannye'
            prev_tok = tok
        
        # Now we need to check if we're inside a date-param function
        # Better approach: parse the AST to find function boundaries
        
        if replacements:
            # Determine which lines belong to date-param functions
            date_func_lines = set()
            try:
                tree = ast.parse(source)
                for node in ast.walk(tree):
                    if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
                        for fp, fn in date_param_functions:
                            if fp == filepath and node.name == fn:
                                # Mark all lines in this function
                                for line in range(node.lineno, node.end_lineno + 1):
                                    date_func_lines.add(line)
            except:
                pass
            
            # Remove replacements for lines inside date-param functions
            final_replacements = {}
            for i, new_name in replacements.items():
                tok = tokens[i]
                if tok.start[0] not in date_func_lines:
                    final_replacements[i] = new_name
            
            if final_replacements:
                new_tokens = list(tokens)
                for i, new_name in final_replacements.items():
                    tok = tokens[i]
                    new_tok = tokenize.TokenInfo(tok.type, new_name, tok.start, tok.end, tok.line)
                    new_tokens[i] = new_tok
                
                new_source = tokenize.untokenize(new_tokens)
                if new_source != source:
                    with open(filepath, 'w') as fh:
                        fh.write(new_source)
                    total_count += len(final_replacements)
                    total_files += 1
                    print(f'{filepath}: {len(final_replacements)} replacements')

print(f'\\nTotal: {total_count} replacements in {total_files} files')
