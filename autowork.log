import re, os, glob

def replace_br_number_in_string(s):
    """Replace Brazilian number format (1.234,56) with Russian (1 234,56) in quoted strings."""
    def replacer(match):
        num = match.group(0)
        if ',' not in num:
            return num
        parts = num.split(',')
        integer_part = parts[0]
        decimal_part = ','.join(parts[1:])
        fixed_integer = integer_part.replace('.', ' ')
        return fixed_integer + ',' + decimal_part
    
    # Match number patterns like 1.234,56 or 25.000.000,00 inside quotes
    result = re.sub(r'\d{1,3}(?:\.\d{3})+,\d{2}', replacer, s)
    return result

# Process all test Python files
for fpath in glob.glob('tests/data/**/*.py', recursive=True):
    with open(fpath, 'r') as f:
        content = f.read()
    
    new_content = replace_br_number_in_string(content)
    
    if new_content != content:
        with open(fpath, 'w') as f:
            f.write(new_content)
        print(f'Updated: {fpath}')

# Also handle test_formatting.py's R$ assertions
print("Done")
