import tokenize, io

# Rename 'url', 'params', 'headers', 'timeout', 'retries', 'last_error', 'attempt' in http_client.py
filepath = 'src/mcp_russia/_shared/http_client.py'

renames_map = {
    'url': 'adres_url',
    'params': 'parametry',
    'headers': 'zagolovki',
    'timeout': 'taimaut',
    'retries': 'povtory',
    'last_error': 'poslednyaya_oshibka',
    'attempt': 'popytka',
}

with open(filepath, 'r') as fh:
    source = fh.read()

tokens = list(tokenize.generate_tokens(io.StringIO(source).readline))
replacements = {}
prev_tok = None

for i, tok in enumerate(tokens):
    if tok.type == tokenize.NAME and tok.string in renames_map:
        # Skip after dot (attribute access)
        if prev_tok and prev_tok.type == tokenize.OP and prev_tok.string == '.':
            prev_tok = tok
            continue
        replacements[i] = renames_map[tok.string]
    prev_tok = tok

if replacements:
    new_tokens = list(tokens)
    for i, new_name in replacements.items():
        tok = tokens[i]
        new_tok = tokenize.TokenInfo(tok.type, new_name, tok.start, tok.end, tok.line)
        new_tokens[i] = new_tok
    
    new_source = tokenize.untokenize(new_tokens)
    with open(filepath, 'w') as fh:
        fh.write(new_source)
    print(f'{filepath}: {len(replacements)} replacements')
    for i, new_name in sorted(replacements.items(), key=lambda x: tokens[x[0]].start):
        print(f'  L{tokens[i].start[0]}: {tokens[i].string} → {new_name}')
"

