    'done', 'complete', 'close', 'open', 'lock', 'unlock', 'wait', 'notify',
    'signal', 'sleep', 'pause', 'resume', 'cancel', 'abort', 'retry', 'reset',
    'sync', 'test', 'mock', 'stub', 'fake', 'dummy', 'fixture', 'setup',
    'teardown', 'desc', 'asc', 'self', 'cls', 'kwargs', 'args', 'true',
    'false', 'none', 'list', 'dict', 'set', 'tuple', 'str', 'int', 'float',
    'bool', 'bytes', 'object', 'class', 'def', 'if', 'else', 'elif', 'for',
    'while', 'with', 'try', 'except', 'finally', 'raise', 'return', 'yield',
    'import', 'from', 'as', 'in', 'not', 'and', 'or', 'is', 'lambda', 'del',
    'global', 'nonlocal', 'assert', 'break', 'continue', 'pass',
}

# Focus on specific interesting ones
focus_words = {'restrictions', 'wanted', 'subject', 'data', 'count', 'number',
    'text', 'message', 'info', 'detail', 'details', 'type', 'code', 'url',
    'link', 'page', 'size', 'length', 'found', 'match', 'search', 'query',
    'request', 'header', 'token', 'auth', 'error', 'warning', 'flag', 'check',
    'handle', 'handler', 'callback', 'tmp', 'temp', 'buf', 'process',
    'build', 'create', 'format', 'load', 'save', 'read', 'write', 'update',
    'delete', 'add', 'remove', 'sort', 'merge', 'split', 'copy', 'find',
    'lookup', 'select', 'group', 'min', 'max', 'limit', 'offset', 'first',
    'last', 'next', 'init', 'start', 'end', 'stop', 'close', 'open',
    'wait', 'retry', 'reset', 'desc', 'asc', 'chunk', 'block', 'node',
    'compute', 'calculate', 'generate', 'convert', 'transform'}

results = {}
for root, dirs, files in os.walk('src/mcp_russia'):
    dirs[:] = [d for d in dirs if d != '__pycache__']
    for f in files:
        if not f.endswith('.py'):
            continue
        filepath = os.path.join(root, f)
        # Skip test files
        if '/tests/' in filepath or filepath.startswith('tests/'):
            continue
        try:
            with open(filepath, 'r') as fh:
                source = fh.read()
            tokens = list(tokenize.generate_tokens(io.StringIO(source).readline))
            prev_tok = None
            for tok in tokens:
                if tok.type == tokenize.NAME and tok.string in focus_words:
                    # Skip after dot (attribute access)
                    if prev_tok and prev_tok.type == tokenize.OP and prev_tok.string == '.':
                        prev_tok = tok
                        continue
                    # Skip string keys (preceded by opening bracket/quote is not a concern for NAME tokens)
                    line = tok.string
                    if filepath not in results:
                        results[filepath] = []
                    results[filepath].append((tok.start[0], tok.string, tok.line.strip()[:100]))
                prev_tok = tok
        except:
            pass

for filepath in sorted(results.keys()):
    items = results[filepath]
    if len(items) > 0:
        # Group by variable name
        by_name = {}
        for line, name, ctx in items:
            if name not in by_name:
                by_name[name] = []
            by_name[name].append((line, ctx))
        print(f'\\n=== {filepath} ===')
        for name in sorted(by_name.keys()):
            occurrences = by_name[name]
            print(f'  {name} ({len(occurrences)} occurrences):')
            for line, ctx in occurrences[:5]:
                print(f'    L{line}: {ctx}')
            if len(occurrences) > 5:
                print(f'    ... and {len(occurrences)-5} more')
"

