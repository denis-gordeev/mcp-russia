import tokenize, io, os

renames = {
    'restrictions': 'ogranicheniya',
    'wanted': 'razyskivaemye',
    'subject': 'predmet',
}

total_count = 0
total_files = 0

# Only in fssp and gibdd directories
target_dirs = ['src/mcp_russia/data/fssp', 'src/mcp_russia/data/gibdd']

for target_dir in target_dirs:
    for root, dirs, files in os.walk(target_dir):
        dirs[:] = [d for d in dirs if d != '__pycache__']
        for f in files:
            if not f.endswith('.py'):
                continue
            filepath = os.path.join(root, f)
            
            with open(filepath, 'r') as fh:
                source = fh.read()
            
            tokens = list(tokenize.generate_tokens(io.StringIO(source).readline))
            replacements = {}
            prev_tok = None
            for i, tok in enumerate(tokens):
                if tok.type == tokenize.NAME and tok.string in renames:
                    # Skip after dot (attribute access)
                    if prev_tok and prev_tok.type == tokenize.OP and prev_tok.string == '.':
                        prev_tok = tok
                        continue
                    # For 'subject' - only rename if it's the fssp subject (предмет исполнения), not 'subject' as 'субъект'
                    # In fssp, 'subject' in .get('subject') is a dict key - check context
                    # Actually, .get('subject') is a string key access, not a NAME token for .get - it's a string
                    # The NAME token 'subject' appears as a variable assignment
                    replacements[i] = renames[tok.string]
                prev_tok = tok
            
            if replacements:
                new_tokens = list(tokens)
                for i, new_name in replacements.items():
                    tok = tokens[i]
                    new_tok = tokenize.TokenInfo(tok.type, new_name, tok.start, tok.end, tok.line)
                    new_tokens[i] = new_tok
                
                new_source = tokenize.untokenize(new_tokens)
                if new_source != source:
                    with open(filepath, 'w') as fh:
                        fh.write(new_source)
                    total_count += len(replacements)
                    total_files += 1
                    print(f'{filepath}: {len(replacements)} replacements')
                    for i, new_name in replacements.items():
                        print(f'  L{tokens[i].start[0]}: {tokens[i].string} → {new_name}')

print(f'\\nTotal: {total_count} replacements in {total_files} files')
"

