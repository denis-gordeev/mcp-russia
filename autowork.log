diff --git a/docs/reference/smart-tools.md b/docs/reference/smart-tools.md
index 7daed789818071ea8c1c851289bc127d0bf24117..b44da38730b17351dfd1ba5d3fd1e4cc771ba5df
--- a/docs/reference/smart-tools.md
