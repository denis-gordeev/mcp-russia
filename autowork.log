    # Replace number patterns in assert strings
    # Pattern: digits.digits,digits → digits digits,digits
    # But only in string literals (assertion strings)
    def replace_br_number(m):
        num = m.group(0)
        # Replace dots that are thousands separators (before comma decimal)
        # e.g., 1.234.567,89 → 1 234 567,89
        # Strategy: split on comma, fix the integer part
        if ',' not in num:
            return num
        parts = num.split(',')
        integer_part = parts[0]
        decimal_part = ','.join(parts[1:])
        # Replace dots with spaces in integer part
        fixed_integer = integer_part.replace('.', ' ')
        return fixed_integer + ',' + decimal_part
    
    # Match pattern: digits with dots and commas (Brazilian number format in strings)
    # Only inside quote strings
    new_content = re.sub(r'(?<=\")(\d{1,3}(?:\.\d{3})+,\d{2})(?=\")', replace_br_number, content)
    # Also handle patterns like R\$ X.XXX,XX
    new_content = re.sub(r'R\\\$ (\d{1,3}(?:\.\d{3})+,\d{2})', lambda m: 'R\\\\$ ' + replace_br_number(m.group(1)), new_content)
    
    if new_content != content:
        with open(fpath, 'w') as f:
            f.write(new_content)
        print(f'Updated: {fpath}')
    else:
        print(f'No changes: {fpath}')
