+    meta = FeatureMeta(
+        name="t",
+        description="T",
+        requires_auth=False,
+        auth_env_var="TEST_OPT_KEY",
+    )
+    with patch.dict(os.environ, {"TEST_OPT_KEY": "val"}):
+        assert meta.is_auth_available() is True
+
 def test_frozen(self) -> None:
