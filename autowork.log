import tokenize, io, os

# Batch 2: data module files
# - text -> tekst (cekrf/client.py - HTML parser)
# - code -> kod (cekrf/client.py, cbrf/tools.py, rosapi/tools.py, rosgidromet/client.py, fssp/tools.py, rosstat/client.py)
# - number -> nomer (kad_arbitrazh/client.py)
# - token -> zheton (rosapi/client.py, gosduma/client.py, zakupki/client.py, fns/client.py)
# - url -> adres_url (all client.py files)
# - start -> nachalo (server.py)

# Skip built-in uses: type(exc), min(), max(), next(), etc.
# Skip attribute access after dot

renames_map = {
    'text': 'tekst',
    'code': 'kod',
    'number': 'nomer',
    'token': 'zheton',
    'url': 'adres_url',
    'start': 'nachalo',
}

# Only target specific files and names
target_files = {}

# text -> tekst in cekrf/client.py
target_files['src/mcp_russia/data/cekrf/client.py'] = {'text', 'code', 'url'}

# code -> kod in tools files
target_files['src/mcp_russia/data/cbrf/tools.py'] = {'code'}
target_files['src/mcp_russia/data/rosapi/tools.py'] = {'code'}
target_files['src/mcp_russia/data/fssp/tools.py'] = {'code'}

# code -> kod in client files
target_files['src/mcp_russia/data/rosgidromet/client.py'] = {'code'}  # but only the _nayti_stantsiyu parameter
target_files['src/mcp_russia/data/rosstat/client.py'] = {'code'}

# number -> nomer in kad_arbitrazh
target_files['src/mcp_russia/data/kad_arbitrazh/client.py'] = {'number'}

# token -> zheton
target_files['src/mcp_russia/data/rosapi/client.py'] = {'token', 'url'}
target_files['src/mcp_russia/data/gosduma/client.py'] = {'token', 'url'}
target_files['src/mcp_russia/data/zakupki/client.py'] = {'token', 'url'}
target_files['src/mcp_russia/data/fns/client.py'] = {'token'}

# url -> adres_url in remaining client files
for module in ['cbrf', 'fssp', 'mchs', 'minobrnauki', 'minzdrav', 'publikatsii', 'rosaudit', 'rospotrebnadzor', 'rosprirodnadzor', 'rosreestr', 'rosselkhoznadzor', 'rosvodresursy', 'sovfed', 'kaznacheistvo']:
    fp = f'src/mcp_russia/data/{module}/client.py'
    if os.path.exists(fp):
        if fp not in target_files:
            target_files[fp] = {'url'}
        else:
            target_files[fp].add('url')

# start -> nachalo in server.py
target_files['src/mcp_russia/server.py'] = {'start'}

total_count = 0
total_files = 0

for filepath, target_names in sorted(target_files.items()):
    if not os.path.exists(filepath):
        continue
        
    with open(filepath, 'r') as fh:
        source = fh.read()
    
    tokens = list(tokenize.generate_tokens(io.StringIO(source).readline))
    replacements = {}
    prev_tok = None
    
    for i, tok in enumerate(tokens):
        if tok.type == tokenize.NAME and tok.string in target_names and tok.string in renames_map:
            # Skip after dot (attribute access)
            if prev_tok and prev_tok.type == tokenize.OP and prev_tok.string == '.':
                prev_tok = tok
                continue
            
            # Skip 'text' and 'type' in prompts.py - these are MCP protocol field names
            if 'prompts.py' in filepath and tok.string in ('text', 'type'):
                prev_tok = tok
                continue
            
            replacements[i] = renames_map[tok.string]
        prev_tok = tok
    
    if replacements:
        new_tokens = list(tokens)
        for i, new_name in replacements.items():
            tok = tokens[i]
            new_tok = tokenize.TokenInfo(tok.type, new_name, tok.start, tok.end, tok.line)
            new_tokens[i] = new_tok
        
        new_source = tokenize.untokenize(new_tokens)
        if new_source != source:
            with open(filepath, 'w') as fh:
                fh.write(new_source)
            total_count += len(replacements)
            total_files += 1
            print(f'{filepath}: {len(replacements)} replacements')
            for i, new_name in replacements.items():
                print(f'  L{tokens[i].start[0]}: {tokens[i].string} → {new_name}')

print(f'\\nTotal: {total_count} replacements in {total_files} files')
"

