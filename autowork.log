import tokenize, io, os

# Find all 'data' NAME tokens that should be renamed to 'dannye'
# We need to exclude:
# 1. After dot (attribute access like exc.data)
# 2. Pydantic schema fields where data='date' (meaning date)
# 3. Function parameters where data means 'date' (like poluchit_vse_valyuty(data=))
# 4. String keys like .get('data')

# Strategy: rename 'data' to 'dannye' only when it's clearly 'data/information',
# keep 'data' when it means 'date'

# First, let's catalog all 'data' occurrences with context
for root, dirs, files in os.walk('src/mcp_russia'):
    dirs[:] = [d for d in dirs if d != '__pycache__']
    for f in files:
        if not f.endswith('.py'):
            continue
        filepath = os.path.join(root, f)
        if '/tests/' in filepath:
            continue
        
        with open(filepath, 'r') as fh:
            source = fh.read()
            lines = source.split('\n')
        
        tokens = list(tokenize.generate_tokens(io.StringIO(source).readline))
        prev_tok = None
        for i, tok in enumerate(tokens):
            if tok.type == tokenize.NAME and tok.string == 'data':
                if prev_tok and prev_tok.type == tokenize.OP and prev_tok.string == '.':
                    prev_tok = tok
                    continue
                lineno = tok.start[0]
                line = lines[lineno - 1].strip()
                # Determine context
                is_schema = filepath.endswith('schemas.py')
                is_param = '=' in line and 'def ' not in line and 'data:' in line
                is_func_param = 'def ' in lines[max(0, lineno - 3):lineno][-1] if lineno > 1 else False
                
                # Classify
                if is_schema:
                    category = 'SCHEMA_FIELD'
