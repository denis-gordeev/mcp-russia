# =============================================================================
# mcp-russia — Переменные окружения
# =============================================================================
# Скопируйте этот файл в .env и заполните нужные значения:
#   cp .env.example .env

# --- Портал открытых данных (опционально) ---
# API-ключ для доступа к защищённым эндпоинтам
OPEN_DATA_API_KEY=

# --- Поиск инструментов (опционально — значения по умолчанию работают) ---
# Режимы: "bm25" (по умолчанию), "code_mode" (экспериментальный), "none" (без фильтрации)
# MCP_RUSSIA_TOOL_SEARCH=bm25

# --- ИИ-рекомендации — rekomendovat_instrumenty / splanirovat_zapros (опционально) ---
# Требуется для инструментов rekomendovat_instrumenty и splanirovat_zapros
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- HTTP-клиент (опционально — значения по умолчанию работают) ---
# MCP_RUSSIA_HTTP_TIMEOUT=30.0
# MCP_RUSSIA_HTTP_MAX_RETRIES=3
# MCP_RUSSIA_HTTP_BACKOFF_BASE=1.0
# MCP_RUSSIA_USER_AGENT=mcp-russia/0.5.0
